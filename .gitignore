# ── 项目补充 ──

# Android 签名 & 本地配置（敏感信息，切勿上传！）
android/key.properties
android/app/release-keystore.jks
android/app/release.keystore
android/app/*.jks
android/app/*.keystore
android/local.properties

# Android 构建缓存
android/.gradle/
android/.kotlin/
android/captures/
.android/

# Node.js 服务端依赖
server/node_modules/
server/.env
server/npm-debug.log*
server/yarn-error.log*

# Flutter 本地缓存
# pubspec.lock 在 Flutter 应用项目中建议提交，保证团队/CI 依赖一致
# 可发布的 Dart 库包（package）则建议忽略
#.flutter-plugins   # 旧版 Flutter 文件

# iOS（如有）
**/ios/Pods/
**/ios/.symlinks/
**/ios/Runner.xcworkspace
**/ios/Runner.xcodeproj/project.xcworkspace
**/ios/Runner.xcodeproj/xcuserdata/
